{
  "name": "esbuild-node-externals",
  "version": "1.22.0",
  "keywords": [
    "bundle",
    "esbuild",
    "esbuild-plugin",
    "node_modules"
  ],
  "license": "MIT",
  "author": "Leo Pradel",
  "repository": "git+https://github.com/pradel/esbuild-node-externals.git",
  "files": [
    "dist",
    "src"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test"
  },
  "dependencies": {
    "empathic": "^2.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.3",
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.0",
    "publint": "0.3.21",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite-plus": "0.1.24"
  },
  "peerDependencies": {
    "esbuild": "0.12 - 0.28"
  },
  "engines": {
    "node": ">=12"
  }
}
